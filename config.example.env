# 可选：预置一个项目 API Key（也可以直接在控制台添加账号自动生成）
MEOO_PROJECT_AK=

# 可选：管理端密码；不设则首次启动随机生成并只在终端打印一次
MEOO2API_ADMIN_PASSWORD=

# 可选：首次启动预置客户端 API Key，多个使用逗号分隔
MEOO2API_KEYS=

# 上游网关
MEOO_AI_BASE=https://api.meoo.host/meoo-ai/compatible-mode/v1

# 监听
BIND=127.0.0.1
PORT=8791

# 数据目录（state.json 落这里，600）
DATA_DIR=data

# 签到日期和执行时间按进程时区计算
TZ=Asia/Shanghai
