# 项目服务 AK（首次启动导入 key 池）；留空则只能 BYOK
MEOO_PROJECT_AK=

# 客户端 key，逗号分隔（首次启动导入访问密钥）
MEOO2API_KEYS=

# 管理端密码；不设则首次启动随机生成并只在终端打印一次
MEOO2API_ADMIN_PASSWORD=

# 上游网关
MEOO_AI_BASE=https://api.meoo.host/meoo-ai/compatible-mode/v1

# 监听（控制台与 OpenAI 接口同端口）
BIND=127.0.0.1
PORT=8791

# 数据目录（state.json 落在这里，600）
DATA_DIR=data
