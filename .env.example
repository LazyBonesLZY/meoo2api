# 项目服务 AK，来自 meoo cloud enable 后的 /cloud/environment
MEOO_PROJECT_AK=meoo_project_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 客户端访问本服务用的 key，逗号分隔；留空则不校验
MEOO2API_KEYS=sk-meoo2api-xxxxxxxxxxxxxxxx

# 上游网关
MEOO_AI_BASE=https://api.meoo.host/meoo-ai/compatible-mode/v1

# 监听
PORT=8791
BIND=127.0.0.1

# 上游超时(ms) / 请求体上限(byte)
UPSTREAM_TIMEOUT=180000
MAX_BODY_BYTES=8388608
