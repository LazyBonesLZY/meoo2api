# 可选：服务端统一持有的项目服务 AK（首次启动会导入 key 池）
MEOO_PROJECT_AK=

# 可选：客户端 key，逗号分隔（首次启动会导入访问密钥）
MEOO2API_KEYS=

# 可选：管理端密码，不设则首次启动随机生成并写入 data/admin-password.txt
MEOO2API_ADMIN_PASSWORD=

# 上游网关
MEOO_AI_BASE=https://api.meoo.host/meoo-ai/compatible-mode/v1

# 监听（控制台与 OpenAI 接口同端口）
PORT=8791
BIND=127.0.0.1

# 上游超时(ms) / 请求体上限(byte)
UPSTREAM_TIMEOUT=180000
MAX_BODY_BYTES=8388608
