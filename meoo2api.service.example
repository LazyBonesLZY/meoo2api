[Unit]
Description=meoo2api (Meoo gateway -> OpenAI compatible)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/meoo2api
# 只监听本机用 -bind 127.0.0.1；要对公网提供则用 0.0.0.0 并自行加防护
ExecStart=%h/meoo2api/meoo2api -bind 0.0.0.0
Environment=HOME=%h
Environment=TZ=Asia/Shanghai
UMask=0077
NoNewPrivileges=true
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
